{
  "name": "informe-md-pdf",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Editor de Markdown paginado con vista A4 en vivo, Git, imágenes y tablas",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "figures": "python3 tools/make_figures.py",
    "check": "typst compile --root . --font-path theme/fonts build/book.typ /tmp/check.pdf",
    "editor:bundle": "esbuild app/renderer/editor-src.js --bundle --format=esm --outfile=app/renderer/vendor/editor.js && esbuild app/renderer/terminal-src.js --bundle --format=esm --outfile=app/renderer/vendor/terminal.js && node -e \"const fs=require('node:fs');fs.mkdirSync('app/renderer/vendor',{recursive:true});fs.copyFileSync('node_modules/@xterm/xterm/css/xterm.css','app/renderer/vendor/xterm.css')\"",
    "app": "npm run editor:bundle && npm run native:rebuild && electron .",
    "app:shot": "npm run editor:bundle && npm run native:rebuild && SHOT_PATH=/tmp/opencode/app.png electron .",
    "prepare:typst": "node tools/prepare-typst.mjs",
    "dist": "npm run editor:bundle && npm run native:rebuild && npm run prepare:typst && electron-builder",
    "native:rebuild": "electron-rebuild -w node-pty",
    "export:html": "node build.mjs --html",
    "export:docx": "node build.mjs --docx",
    "export:all": "node build.mjs --html --docx"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "mdast-util-to-string": "^4.0.0",
    "node-pty": "^1.1.0",
    "remark-directive": "^4.0.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.5",
    "temml": "^0.14.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@electron/rebuild": "^4.2.1",
    "@lezer/highlight": "^1.2.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "main": "app/main.mjs",
  "author": {
    "name": "SeviNy0",
    "email": "sevinyo0909@gmail.com"
  },
  "build": {
    "appId": "app.informe.md",
    "productName": "MDF",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**/*",
      "core/**/*",
      "theme/**/*",
      "package.json"
    ],
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "docs/icon.png",
      "maintainer": "SeviNy0 <sevinyo0909@gmail.com>",
      "artifactName": "MDF-${version}-${arch}.${ext}",
      "synopsis": "Editor de Markdown con vista paginada A4 y exportación PDF",
      "description": "Escribe Markdown, revisa las hojas A4 en vivo, edita imágenes y tablas, y exporta un PDF con Typst.",
      "extraResources": [
        {
          "from": "vendor/typst",
          "to": "typst"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "docs/icon.ico",
      "artifactName": "MDF-${version}-x64-portable.${ext}",
      "extraResources": [
        {
          "from": "vendor/typst.exe",
          "to": "typst.exe"
        }
      ]
    },
    "asarUnpack": [
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/node-pty/**"
    ]
  },
  "homepage": "https://github.com/SeviNy0/MDF",
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
